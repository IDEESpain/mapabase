# Copiar a .env y rellenar (no subir a git).
PGHOST=10.67.33.159
PGPORT=5432
PGDATABASE=mapabasexyz
PGUSER=guadaltel_servicios_cnig
PGPASSWORD=

# Ruta datos CNIG (run_pipeline_sql.py --datos-base si no se usa esta variable)
# MC_DATOS_BASE=/var/MVT_MapaBaseXYZ/DatosProcesados

# Sesión de Tilekiln/psql: PostGIS en public o public_modelo_2025; JIT fuera (consultas de tesela cortas)
PGOPTIONS="-c search_path=public,public_modelo_2025 -c jit=off"

# Servicio (tools/tilekiln_servicio.sh)
# TK_PORT=8099
# TK_WORKERS=4
# TK_CONFIG=config_rapido.yaml
