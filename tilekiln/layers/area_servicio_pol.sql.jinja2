-- Capa area_servicio_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{unbuffered_bbox}}, {{extent}}, {{buffer}}, true) AS way,
    clase,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.area_servicio_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.area_servicio_pol
{% else %}
  FROM mc_servicio_local.area_servicio_pol
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom <= 13 %}
  AND ST_Area(the_geom) >= {{coordinate_area}}
{% endif %}
