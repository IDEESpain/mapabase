-- Capa ferrocarril_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g8 z<=8 | g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    estado,
    nombre,
    proveedor,
    puente,
    tipo_tramo,
    tunel
{% if zoom <= 8 %}
  FROM mc_servicio_nacional.ferrocarril_lin_g8
{% elif zoom <= 11 %}
  FROM mc_servicio_nacional.ferrocarril_lin_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.ferrocarril_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.ferrocarril_lin
{% else %}
  FROM mc_servicio_local.ferrocarril_lin
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom >= 7 and zoom <= 11 %}
  AND clase = 'tren'
{% elif (zoom >= 12 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
