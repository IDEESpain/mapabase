-- Capa altimetria_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    altitud,
    clase,
    proveedor
{% if zoom <= 11 %}
  FROM mc_servicio_nacional.altimetria_lin_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.altimetria_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.altimetria_lin
{% else %}
  FROM mc_servicio_local.altimetria_lin
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom == 11 %}
  AND altitud IN ('100', '200', '300', '400', '500', '600', '700', '800', '900', '1000', '1100', '1200', '1300', '1400', '1500', '1600', '1700', '1800', '1900', '2000', '2100', '2200', '2300', '2400', '2500', '2600', '2700', '2800', '2900', '3000', '3100', '3200', '3300', '3400', '3500', '3600', '3700', '3800')
{% elif zoom == 12 %}
  AND altitud IN ('50', '100', '150', '200', '250', '300', '350', '400', '450', '500', '550', '600', '650', '700', '750', '800', '850', '900', '950', '1000', '1050', '1100', '1150', '1200', '1250', '1300', '1350', '1400', '1450', '1500', '1550', '1600', '1650', '1700', '1750', '1800', '1850', '1900', '1950', '2000', '2050', '2100', '2150', '2200', '2250', '2300', '2350', '2400', '2450', '2500', '2550', '2600', '2650', '2700', '2750', '2800', '2850', '2900', '2950', '3000', '3050', '3100', '3150', '3200', '3250', '3300', '3350', '3400', '3450', '3500', '3550', '3600', '3650', '3700', '3750', '3800')
{% elif (zoom >= 13 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
