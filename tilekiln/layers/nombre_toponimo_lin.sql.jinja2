-- Capa nombre_toponimo_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g8 z<=8 | g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    jerarquia,
    nombre,
    nombre_alt,
    proveedor
{% if zoom <= 8 %}
  FROM mc_servicio_nacional.nombre_toponimo_lin_g8
{% elif zoom <= 11 %}
  FROM mc_servicio_nacional.nombre_toponimo_lin_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.nombre_toponimo_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.nombre_toponimo_lin
{% else %}
  FROM mc_servicio_local.nombre_toponimo_lin
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom >= 4 and zoom <= 6 %}
  AND clase = 'sierra'
{% elif (zoom >= 7 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
