-- Capa provincia_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    codigo,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.provincia_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.provincia_pol
{% else %}
  FROM mc_servicio_local.provincia_pol
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom == 7 %}
  AND clase = 'provincia'
{% elif (zoom >= 8 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
;
