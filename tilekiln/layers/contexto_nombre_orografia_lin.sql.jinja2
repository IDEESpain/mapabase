-- Capa contexto_nombre_orografia_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g8 z<=8 | g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    esp,
    nombre,
    proveedor
{% if zoom <= 8 %}
  FROM mc_servicio_nacional.contexto_nombre_orografia_lin_g8
{% elif zoom <= 11 %}
  FROM mc_servicio_nacional.contexto_nombre_orografia_lin_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.contexto_nombre_orografia_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.contexto_nombre_orografia_lin
{% else %}
  FROM mc_servicio_local.contexto_nombre_orografia_lin
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom == 7 %}
  AND esp = '0'
{% elif (zoom >= 3 and zoom <= 4) or (zoom >= 8 and zoom <= 12) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
