-- Capa ferrocarril_pk_pto (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    proveedor,
    ref
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.ferrocarril_pk_pto
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.ferrocarril_pk_pto
{% else %}
  FROM mc_servicio_local.ferrocarril_pk_pto
{% endif %}
  WHERE the_geom && {{bbox}}
;
