-- Capa nombre_division_administrativa_pto (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    nombre,
    nombre_alt,
    jerarquia,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.nombre_division_administrativa_pto
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.nombre_division_administrativa_pto
{% else %}
  FROM mc_servicio_local.nombre_division_administrativa_pto
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom >= 3 and zoom <= 4 %}
  AND clase = 'nacion'
{% elif zoom == 5 %}
  AND clase IN ('ciudad_autonoma', 'comunidad_autonoma', 'nacion')
{% elif zoom >= 6 and zoom <= 8 %}
  AND clase IN ('ciudad_autonoma', 'comunidad_autonoma', 'nacion', 'provincia')
{% elif zoom == 9 %}
  AND clase IN ('ciudad_autonoma', 'comunidad_autonoma', 'municipio', 'nacion', 'provincia')
{% elif (zoom >= 10 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
;
