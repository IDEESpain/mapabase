-- Capa servicio_instalacion_pto (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{unbuffered_bbox}}, {{extent}}, {{buffer}}, true) AS way,
    clase,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.servicio_instalacion_pto
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.servicio_instalacion_pto
{% else %}
  FROM mc_servicio_local.servicio_instalacion_pto
{% endif %}
  WHERE the_geom && {{bbox}}
