-- Capa linea_limite_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g8 z<=8 | g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    nombre,
    proveedor,
    ref
{% if zoom <= 8 %}
  FROM mc_servicio_nacional.linea_limite_lin_g8
{% elif zoom <= 11 %}
  FROM mc_servicio_nacional.linea_limite_lin_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.linea_limite_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.linea_limite_lin
{% else %}
  FROM mc_servicio_local.linea_limite_lin
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom >= 5 and zoom <= 6 %}
  AND clase IN ('limite_autonomico', 'limite_nacional')
{% elif zoom >= 7 and zoom <= 8 %}
  AND clase IN ('limite_autonomico', 'limite_provincial', 'limite_nacional')
{% elif (zoom >= 9 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
