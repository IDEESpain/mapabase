-- Capa puerto_pto (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    nombre,
    proveedor,
    ref,
    estado
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.puerto_pto
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.puerto_pto
{% else %}
  FROM mc_servicio_local.puerto_pto
{% endif %}
  WHERE the_geom && {{bbox}}
;
