-- Capa conduccion_lin (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.conduccion_lin
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.conduccion_lin
{% else %}
  FROM mc_servicio_local.conduccion_lin
{% endif %}
  WHERE the_geom && {{bbox}}
