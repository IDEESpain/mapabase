-- Capa municipio_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    codigo,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.municipio_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.municipio_pol
{% else %}
  FROM mc_servicio_local.municipio_pol
{% endif %}
  WHERE the_geom && {{bbox}}
;
