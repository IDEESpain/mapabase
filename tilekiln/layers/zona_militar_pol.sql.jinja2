-- Capa zona_militar_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.zona_militar_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.zona_militar_pol
{% else %}
  FROM mc_servicio_local.zona_militar_pol
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom == 12 %}
  AND clase = 'zona_militar'
{% elif (zoom >= 13 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
