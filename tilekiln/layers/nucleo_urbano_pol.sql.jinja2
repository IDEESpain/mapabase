-- Capa nucleo_urbano_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: g11 z<=11 | nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    cod_ine,
    municipio,
    nombre,
    proveedor
{% if zoom <= 11 %}
  FROM mc_servicio_nacional.nucleo_urbano_pol_g11
{% elif zoom <= 13 %}
  FROM mc_servicio_nacional.nucleo_urbano_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.nucleo_urbano_pol
{% else %}
  FROM mc_servicio_local.nucleo_urbano_pol
{% endif %}
  WHERE the_geom && {{bbox}}
