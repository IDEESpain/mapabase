-- Capa lamina_agua_pol (Tilekiln / Mapa Ciudadano)
-- Fuente por zoom: nacional z0-13 | regional z14-16 | local z17+
SELECT
    ST_AsMVTGeom(the_geom, {{bbox}}, {{extent}}) AS way,
    clase,
    persistencia,
    nombre,
    proveedor
{% if zoom <= 13 %}
  FROM mc_servicio_nacional.lamina_agua_pol
{% elif zoom <= 16 %}
  FROM mc_servicio_regional.lamina_agua_pol
{% else %}
  FROM mc_servicio_local.lamina_agua_pol
{% endif %}
  WHERE the_geom && {{bbox}}
{% if zoom >= 8 and zoom <= 11 %}
  AND clase IN ('embalse', 'marisma')
{% elif zoom >= 12 and zoom <= 14 %}
  AND clase IN ('balsa_alberca', 'embalse', 'lago', 'marisma')
{% elif (zoom >= 15 and zoom <= 22) %}
  -- sin filtro tippecanoe en este zoom
{% endif %}
;
